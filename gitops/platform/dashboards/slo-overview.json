      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Burn rate (5m)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (sloth_id) (slo:objective:ratio{sloth_service=~\"$sloth_service\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (sloth_id) (1 - slo:sli_error:ratio_rate5m{sloth_service=~\"$sloth_service\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (sloth_id) (slo:period_error_budget_remaining:ratio{sloth_service=~\"$sloth_service\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (sloth_id) (slo:current_burn_rate:ratio{sloth_service=~\"$sloth_service\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "SLO status",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "sloth_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(sloth_id|Value #[ABCD])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "sloth_id": "SLO",
              "Value #A": "Objective",
              "Value #B": "Current SLI (5m)",
              "Value #C": "Budget remaining (30d)",
              "Value #D": "Burn rate (5m)"
            }
          }
        }
      ],
      "type": "table"
